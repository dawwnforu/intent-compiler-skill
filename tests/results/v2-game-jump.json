between;gap:12px;font-size:12px;color:#a0b3bc;margin-top:18px;line-height:1.8}.dot{color:#ffb275;margin-right:6px}@media(max-width:480px){body{padding-left:16px;padding-right:16px}header{margin-bottom:18px}.scores{gap:18px}.stage{height:60vh;max-height:540px}footer{font-size:11px}.brand{font-size:23px}}\n</style>\n</head>\n<body>\n<main class=\"app\">\n<header><div class=\"brand\">轻跳<span>A LITTLE HOP</span></div><div class=\"scores\"><div><small>本次得分</small><strong id=\"score\">0</strong></div><div><small>最高纪录</small><strong id=\"best\">0</strong></div></div></header>\n<div class=\"stage\" id=\"stage\" aria-label=\"小球跳障碍游戏区域\">\n<canvas id=\"game\" aria-label=\"点按屏幕或按空格让小球跳过障碍\"></canvas>\n<div class=\"overlay\" id=\"overlay\"><div class=\"eyebrow\" id=\"eyebrow\">轻轻一点，向前一点</div><h1 id=\"title\">准备好跳一跳？</h1><p id=\"message\">点屏幕让小球跳过障碍<br>找到节奏，看看能走多远</p><button id=\"action\" type=\"button\">开始游戏 →</button></div>\n</div>\n<footer><span><span class=\"dot\">●</span>点按跳跃 · 电脑也可按空格</span><span>不赶路，找节奏。</span></footer>\n<div id=\"announcement\" role=\"status\" aria-live=\"polite\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)\"></div>\n</main>\n<script>\n(()=>{\n'use strict';\nconst canvas=document.getElementById('game'),ctx=canvas.getContext('2d'),stage=document.getElementById('stage');\nconst overlay=document.getElementById('overlay'),action=document.getElementById('action'),scoreEl=document.getElementById('score'),bestEl=document.getElementById('best');\nconst reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;\nlet best=0;try{best=Number(localStorage.getItem('little-hop-best'))||0}catch{}bestEl.textContent=best;\nlet W=800,ballX=145;const H=440,ground=340,radius=19;\nlet state='ready',y=ground-radius,vy=0,obstacles=[],elapsed=0,distance=0,score=0,spawn=1.8,squash=0,buffer=0,previous=0,accumulator=0;\nfunction resize(){const box=stage.getBoundingClientRect(),dpr=Math.min(devicePixelRatio||1,2),oldW=W;W=H*box.width/box.height;ballX=Math.min(145,W*.22);for(const o of obstacles)o.x*=W/oldW;canvas.width=Math.round(box.width*dpr);canvas.height=Math.round(box.height*dpr);draw()}\nfunction start(){state='running';y=ground-radius;vy=0;obstacles=[];elapsed=0;distance=0;score=0;spawn=1.8;squash=0;buffer=0;accumulator=0;scoreEl.textContent=0;overlay.hidden=true;document.getElementById('announcement').textContent='游戏开始';}\nfunction jump(){if(state==='ready'||state==='over'){start();return}if(state==='paused'){resume();return}buffer=.12;}\nfunction end(){state='over';buffer=0;best=Math.max(best,score);bestEl.textContent=best;try{localStorage.setItem('little-hop-best',String(best))}catch{}document.getElementById('eyebrow').textContent='下一跳，也许更远';document.getElementById('title').textContent='再跳一次？';document.getElementById('message').textContent='本次 '+score+' 分 · 最高 '+best+' 分';action.textContent='马上重来 ↻';overlay.hidden=false;document.getElementById('announcement').textContent='游戏结束，得分 '+score;}\nfunction resume(){state='running';overlay.hidden=true;accumulator=0;previous=0;}\nfunction update(dt){\n if(state!=='running')return;\n elapsed+=dt;const speed=Math.min(430,260+elapsed*3)*Math.min(1,Math.max(.55,W/800));distance+=speed*dt;spawn-=dt;buffer=Math.max(0,buffer-dt);squash=Math.max(0,squash-dt*4);\n if(buffer>0&&y>=ground-radius-.1){vy=-610;buffer=0;}\n vy+=1700*dt;y+=vy*dt;if(y>=ground-radius){if(vy>100)squash=1;y=ground-radius;vy=0;}\n if(spawn<=0){const width=28+Math.random()*16,height=32+Math.random()*23;obstacles.push({x:W+40,w:width,h:height,passed:false});spawn=1.35+Math.random()*.5;}\n for(const o of obstacles){o.x-=speed*dt;const nx=Math.max(o.x,Math.min(ballX,o.x+o.w)),ny=Math.max(ground-o.h,Math.min(y,ground));if((ballX-nx)**2+(y-ny)**2<(radius-2)**2){end();return}if(!o.passed&&o.x+o.w<ballX-radius){o.passed=true;score++;scoreEl.textContent=score;}}\n obstacles=obstacles.filter(o=>o.x+o.w>-20);\n}\nfunction rounded(x,y,w,h,r,color){ctx.fillStyle=color;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}\nfunction draw(){\n ctx.setTransform(canvas.width/W,0,0,canvas.height/H,0,0);ctx.clearRect(0,0,W,H);ctx.fillStyle='#1c303e';ctx.fillRect(0,0,W,H);\n ctx.fillStyle='#263c48';ctx.beginPath();ctx.moveTo(0,280);ctx.quadraticCurveTo(170,160,360,270);ctx.quadraticCurveTo(600,170,800,250);ctx.lineTo(800,ground);ctx.lineTo(0,ground);ctx.fill();\n ctx.fillStyle='#304954';ctx.beginPath();ctx.arc(674,84,27,0,Math.PI*2);ctx.fill();\n ctx.fillStyle='#203541';ctx.fillRect(0,ground,W,H-ground);ctx.strokeStyle='#56706f';ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(0,ground);ctx.lineTo(W,ground);ctx.stroke();\n const offset=reduced?0:distance%90;for(let x=-offset;x<W;x+=90){rounded(x,ground+27,24,3,1.5,'#3c535b')}\n for(const o of obstacles){rounded(o.x,ground-o.h,o.w,o.h,6,'#a6c9b6');rounded(o.x+5,ground-o.h+5,o.w-10,3,1.5,'#c6dfce')}\n ctx.fillStyle='#10232d55';ctx.beginPath();ctx.ellipse(ballX,ground+5,Math.max(9,24-(ground-radius-y)*.06),5,0,0,Math.PI*2);ctx.fill();\n let sx=1,sy=1;if(!reduced){sx=1+squash*.17;sy=1-squash*.17;if(vy<-100){sx=.94;sy=1.06}}\n ctx.save();ctx.translate(ballX,y+radius*(1-sy));ctx.scale(sx,sy);ctx.fillStyle='#ffb275';ctx.beginPath();ctx.arc(0,0,radius,0,Math.PI*2);ctx.fill();ctx.fillStyle='#ffd1a6';ctx.beginPath();ctx.arc(-6,-7,5,0,Math.PI*2);ctx.fill();ctx.restore();\n if(state==='running'&&elapsed<3){ctx.fillStyle='#bdcbd0';ctx.font='16px system-ui';ctx.textAlign='center';ctx.fillText('点一下，跳起来',W/2,110)}\n}\nfunction frame(now){if(!previous)previous=now;const dt=Math.min((now-previous)/1000,.05);previous=now;if(state==='running'){accumulator+=dt;while(accumulator>=1/120){update(1/120);accumulator-=1/120;if(state!=='running')break;}}draw();requestAnimationFrame(frame)}\nstage.addEventListener('pointerdown',e=>{if(e.target.closest('button'))return;e.preventDefault();jump()});action.addEventListener('click',()=>state==='paused'?resume():start());\ndocument.addEventListener('keydown',e=>{if((e.code==='Space'||e.code==='ArrowUp')&&!e.repeat){if(e.target===action)return;e.preventDefault();jump()}});\ndocument.addEventListener('visibilitychange',()=>{if(document.hidden&&state==='running'){state='paused';document.getElementById('eyebrow').textContent='休息一下';document.getElementById('title').textContent='游戏已暂停';document.getElementById('message').textContent='准备好了就继续';action.textContent='继续游戏 →';overlay.hidden=false;}});\nwindow.addEventListener('resize',resize);resize();requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>\n"
