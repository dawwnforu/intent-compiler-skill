      "html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#edf1e8\">\n<title>跳一下 · 小球障碍游戏</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;height:100%;overflow:hidden}body{background:#edf1e8;color:#273d35;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif}main{height:100%;height:100dvh;max-width:1100px;margin:auto;display:flex;flex-direction:column;padding: max(24px,env(safe-area-inset-top)) 24px max(18px,env(safe-area-inset-bottom))}header{display:flex;align-items:center;justify-content:space-between;gap:16px}h1{font-size:25px;letter-spacing:-1px;margin:0}h1 span{color:#849187;font-size:12px;letter-spacing:2px;display:block;margin-top:5px;font-weight:500}.scores{display:flex;gap:24px}.scores label{font-size:11px;color:#65786e;display:block}.scores strong{font-size:26px;font-variant-numeric:tabular-nums}#arena{position:relative;flex:1;min-height:200px;margin:24px 0 14px;border:1px solid #d7dfd3;border-radius:28px;overflow:hidden;background:#f7f8f1;touch-action:none;user-select:none;outline-offset:4px}canvas{width:100%;height:100%;display:block}.overlay{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;text-align:center;padding:24px;background:linear-gradient(#f7f8f100,#f7f8f1b3 50%,#f7f8f100);pointer-events:none}.overlay[hidden]{display:none}.eyebrow{font-size:11px;letter-spacing:3px;color:#6d8274}h2{font-size:clamp(28px,5vw,48px);letter-spacing:-2px;margin:12px 0}#message{font-size:14px;line-height:1.8;color:#62766a;margin:0 0 22px}button{border:0;border-radius:40px;background:#284c3d;color:#fff;padding:14px 28px;font:600 15px system-ui;cursor:pointer;pointer-events:auto;min-height:48px}button:focus-visible{outline:3px solid #dc874a;outline-offset:4px}footer{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:#697d70;line-height:1.7}.dot{color:#cc6f40}#pause{position:absolute;right:16px;top:16px;font-size:12px;padding:9px 15px;min-height:44px;background:#e6ecdf;color:#385344}#status{position:absolute;left:18px;top:22px;font-size:11px;letter-spacing:2px;color:#728577}@media(max-width:520px){main{padding-left:16px;padding-right:16px}header{padding:0 4px}h1{font-size:23px}.scores{gap:18px}#arena{margin-top:20px;border-radius:22px}footer{font-size:11px}.desktop{display:none}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto}}\n</style>\n</head>\n<body>\n<main>\n <header><h1>跳一下<span>A LITTLE MOMENT OF PLAY</span></h1><div class=\"scores\"><div><label>本次得分</label><strong id=\"score\">0</strong></div><div><label>最高纪录</label><strong id=\"best\">0</strong></div></div></header>\n <div id=\"arena\" tabindex=\"0\" role=\"application\" aria-label=\"小球跳障碍游戏，点按或按空格跳跃\">\n  <canvas id=\"canvas\" aria-hidden=\"true\"></canvas><span id=\"status\">准备出发</span><button id=\"pause\" hidden aria-label=\"暂停游戏\">暂停</button>\n  <div class=\"overlay\" id=\"overlay\"><span class=\"eyebrow\" id=\"eyebrow\">轻轻一点，向前一点</span><h2 id=\"title\">把障碍留在身后。</h2><p id=\"message\">点屏幕，小球就会跳。<br>越过障碍，看看能走多远。</p><button id=\"action\">开始 · 跳一下</button></div>\n </div>\n <footer><span><span class=\"dot\">●</span> 点按跳跃 <span class=\"desktop\">/ 空格键也可以</span></span><span>保持节奏，慢慢来。</span></footer>\n <span id=\"announcement\" role=\"status\" aria-live=\"polite\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)\"></span>\n</main>\n<script>\n(()=>{\n'use strict';\nconst $=id=>document.getElementById(id), canvas=$('canvas'),ctx=canvas.getContext('2d'),arena=$('arena');\nconst reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;\nlet best=0;try{best=Number(localStorage.getItem('jump-a-little-best'))||0}catch(e){}$('best').textContent=best;\nlet W=900,px=160;const H=520,ground=398,r=19;\nlet state='ready',ballY=ground-r,vy=0,obstacles=[],score=0,speed=290,distance=0,spawn=1.65,last=0,squash=0;\nfunction resize(){const dpr=Math.min(devicePixelRatio||1,2),rect=arena.getBoundingClientRect();W=H*rect.width/rect.height;px=Math.min(160,W*.23);canvas.width=Math.round(rect.width*dpr);canvas.height=Math.round(rect.height*dpr);draw()}\nfunction screen(title,message,action,eyebrow){$('overlay').hidden=false;$('title').textContent=title;$('message').textContent=message;$('action').textContent=action;$('eyebrow').textContent=eyebrow}\nfunction start(){state='playing';ballY=ground-r;vy=0;obstacles=[];score=0;speed=290;distance=0;spawn=1.65;squash=0;$('score').textContent=0;$('overlay').hidden=true;$('pause').hidden=false;$('pause').textContent='暂停';$('status').textContent='向前，向前';jump()}\nfunction jump(){if(ballY>=ground-r-.5){vy=-650;squash=.13}}\nfunction input(){if(state==='ready'||state==='over')start();else if(state==='paused')resume();else jump()}\nfunction finish(){state='over';$('pause').hidden=true;if(score>best){best=score;$('best').textContent=best;try{localStorage.setItem('jump-a-little-best',String(best))}catch(e){}}$('status').textContent='稍作停留';screen('再跳一次？','这次越过了 '+score+' 个障碍。点一下，就能重新出发。','马上重来','每一次，都会更顺一点');$('announcement').textContent='游戏结束，得分 '+score+'。可以马上重来。'}\nfunction pause(){if(state!=='playing')return;state='paused';$('pause').textContent='继续';$('status').textContent='已暂停';screen('歇一小会儿。','准备好了，再继续向前。','继续游戏','不用着急')}\nfunction resume(){state='playing';last=0;$('overlay').hidden=true;$('pause').textContent='暂停';$('status').textContent='向前，向前'}\nfunction step(dt){if(state!=='playing')return;distance+=speed*dt;vy+=1800*dt;ballY+=vy*dt;if(ballY>=ground-r){if(vy>150)squash=-.18;ballY=ground-r;vy=0}squash*=Math.exp(-dt*15);spawn-=dt;if(spawn<=0){obstacles.push({x:W+40,w:30+Math.random()*12,h:38+Math.random()*17,passed:false});spawn=(380+Math.random()*170)/speed}for(const o of obstacles){o.x-=speed*dt;const cx=Math.max(o.x,Math.min(px,o.x+o.w)),cy=Math.max(ground-o.h,Math.min(ballY,ground));if((px-cx)**2+(ballY-cy)**2<(r-2)**2){finish();return}if(!o.passed&&o.x+o.w<px-r){o.passed=true;score++;$('score').textContent=score;speed=Math.min(440,290+score*5)}}obstacles=obstacles.filter(o=>o.x+o.w>-50)}\nfunction round(x,y,w,h,rad,color){ctx.fillStyle=color;ctx.beginPath();ctx.roundRect(x,y,w,h,rad);ctx.fill()}\nfunction draw(){const width=canvas.width,height=canvas.height;ctx.setTransform(width/W,0,0,height/H,0,0);ctx.clearRect(0,0,W,H);ctx.fillStyle='#f7f8f1';ctx.fillRect(0,0,W,H);\nctx.fillStyle='#e7eddf';ctx.beginPath();ctx.moveTo(0,ground);ctx.bezierCurveTo(150,270,220,330,370,ground);ctx.bezierCurveTo(540,235,660,300,900,ground);ctx.closePath();ctx.fill();\nctx.strokeStyle='#dbe3d3';ctx.lineWidth=1;for(let i=0;i<3;i++){let x=180+i*320-(reduced?0:distance*.08)%320;ctx.beginPath();ctx.arc(x,145+i%2*42,26,Math.PI,0);ctx.stroke()}\nctx.fillStyle='#e0e7d8';ctx.fillRect(0,ground,W,H-ground);ctx.strokeStyle='#bccab5';ctx.beginPath();ctx.moveTo(0,ground+.5);ctx.lineTo(W,ground+.5);ctx.stroke();\nctx.strokeStyle='#b9c8af';ctx.lineWidth=2;for(let i=0;i<16;i++){const x=i*70-distance%70;ctx.beginPath();ctx.moveTo(x,ground+28);ctx.lineTo(x+16,ground+28);ctx.stroke()}\nfor(const o of obstacles){round(o.x+4,ground+4,o.w+8,5,3,'#c5d0bb');round(o.x,ground-o.h,o.w,o.h,6,'#426451');round(o.x+5,ground-o.h+5,4,o.h-10,2,'#658470')}\nconst elevation=(ground-r-ballY)/120;ctx.fillStyle='#bac7ad';ctx.beginPath();ctx.ellipse(px,ground+4,Math.max(9,23-elevation*9),4,0,0,Math.PI*2);ctx.fill();\nctx.save();ctx.translate(px,ballY);const deform=reduced?0:squash;ctx.scale(1-deform,1+deform);ctx.fillStyle='#dc8050';ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill();ctx.fillStyle='#f7bb89';ctx.beginPath();ctx.arc(-6,-7,5,0,Math.PI*2);ctx.fill();ctx.restore();\n}\nfunction frame(t){const dt=last?Math.min((t-last)/1000,.05):0;last=t;let remain=dt;while(remain>0){const part=Math.min(remain,1/120);step(part);remain-=part}draw();requestAnimationFrame(frame)}\narena.addEventListener('pointerdown',e=>{if(e.target.closest('button'))return;e.preventDefault();input()});$('action').addEventListener('click',input);$('pause').addEventListener('click',()=>state==='paused'?resume():pause());document.addEventListener('keydown',e=>{if(e.code==='Space'||e.code==='ArrowUp'){if(e.target.closest('button'))return;e.preventDefault();if(!e.repeat)input()}if(e.code==='Escape')state==='playing'?pause():state==='paused'&&resume()});document.addEventListener('visibilitychange',()=>{if(document.hidden)pause();last=0});window.addEventListener('resize',resize);resize();requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>\n"
