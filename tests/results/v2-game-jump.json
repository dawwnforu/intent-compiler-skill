      "html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#102323\">\n<title>跃过 · 小球跑酷</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;height:100%;background:#102323;color:#edf7ec;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif}body{display:grid;place-items:center;padding:20px;padding:max(20px,env(safe-area-inset-top)) max(20px,env(safe-area-inset-right)) max(20px,env(safe-area-inset-bottom)) max(20px,env(safe-area-inset-left))}.shell{width:min(100%,900px)}header{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px}.brand{font-size:22px;font-weight:800;letter-spacing:3px}.brand small{font-size:10px;font-weight:500;letter-spacing:2px;color:#90aaa3;display:block;margin-top:5px}.stats{display:flex;gap:24px;text-align:right}.stats span{display:block;color:#90aaa3;font-size:11px;margin-bottom:3px}.stats strong{font-size:24px;font-variant-numeric:tabular-nums}.stage{position:relative;overflow:hidden;border:1px solid #45605a;border-radius:24px;background:#d9e7d5;box-shadow:0 20px 65px #0003;touch-action:none;user-select:none;outline:none}.stage:focus-visible{outline:3px solid #d5ee83;outline-offset:5px}canvas{display:block;width:100%;height:clamp(280px,55vh,460px)}.overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#d9e7d5dd;color:#193c33;padding:24px;text-align:center}.overlay.hidden{display:none}.tag{font-size:11px;letter-spacing:3px;color:#5e7768;margin-bottom:14px}h1{font-size:clamp(30px,6vw,48px);margin:0 0 12px;letter-spacing:2px}.overlay p{margin:0 0 24px;color:#5b7262;font-size:14px;line-height:1.8}button{border:0;border-radius:50px;padding:14px 32px;background:#193c33;color:#f2f8df;font:700 15px system-ui;cursor:pointer;touch-action:manipulation}button:active{transform:scale(.97)}footer{display:flex;justify-content:space-between;gap:12px;font-size:12px;color:#90aaa3;margin-top:18px;line-height:1.7}.dot{display:inline-block;width:6px;height:6px;background:#d5ee83;border-radius:50%;margin-right:7px}@media(max-width:480px){body{padding:16px}.stats{gap:16px}.stage{border-radius:20px}footer{font-size:11px}canvas{height:55vh;min-height:300px}}\n</style>\n</head>\n<body>\n<main class=\"shell\">\n<header><div class=\"brand\">跃过<small>ONE TAP / KEEP GOING</small></div><div class=\"stats\"><div><span>本次得分</span><strong id=\"score\">0</strong></div><div><span>最佳纪录</span><strong id=\"best\">0</strong></div></div></header>\n<div class=\"stage\" id=\"stage\" tabindex=\"0\" role=\"application\" aria-label=\"小球跳障碍游戏，点按或空格跳跃\">\n<canvas id=\"game\" aria-label=\"游戏画面\"></canvas>\n<div class=\"overlay\" id=\"overlay\"><div class=\"tag\" id=\"tag\">轻轻一点，向前一点</div><h1 id=\"title\">让小球跃起来</h1><p id=\"message\">点屏幕跳过障碍<br>把握节奏，看看能跑多远</p><button id=\"start\">开始跑吧 →</button></div>\n</div>\n<footer><span><i class=\"dot\"></i>点按跳跃 · 电脑可按空格 / ↑</span><span>轻快前行，不必着急</span></footer>\n<div id=\"status\" role=\"status\" aria-live=\"polite\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)\"></div>\n</main>\n<script>\nconst canvas=document.getElementById('game'),ctx=canvas.getContext('2d');\nconst stage=document.getElementById('stage'),overlay=document.getElementById('overlay');\nconst scoreEl=document.getElementById('score'),bestEl=document.getElementById('best');\nconst W=900,H=460,ground=352,radius=18,playerX=145;\nlet state='ready',y=ground-radius,vy=0,speed=290,distance=0,score=0,best=0,obstacles=[],spawnIn=1.4,last=0,trail=[],squash=0;\ntry{best=Number(localStorage.getItem('hop-best'))||0}catch(e){}bestEl.textContent=best;\nfunction resize(){const dpr=Math.min(window.devicePixelRatio||1,2);canvas.width=Math.round(canvas.clientWidth*dpr);canvas.height=Math.round(canvas.clientHeight*dpr)}\nwindow.addEventListener('resize',resize);resize();\nfunction start(){state='running';y=ground-radius;vy=0;speed=290;distance=0;score=0;obstacles=[];trail=[];spawnIn=1.4;squash=0;scoreEl.textContent=0;overlay.classList.add('hidden');last=0;document.getElementById('status').textContent='游戏开始';}\nfunction jump(){if(state!=='running'){start();return}if(y>=ground-radius-.1){vy=-650;squash=-.12}}\nfunction end(){state='over';if(score>best){best=score;bestEl.textContent=best;try{localStorage.setItem('hop-best',String(best))}catch(e){}}document.getElementById('tag').textContent='这一次，也向前了一点';document.getElementById('title').textContent='再跃一次？';document.getElementById('message').textContent='本次得分 '+score+' · 最佳纪录 '+best;document.getElementById('start').textContent='马上重来 →';overlay.classList.remove('hidden');document.getElementById('status').textContent='游戏结束，得分 '+score;}\nstage.addEventListener('pointerdown',e=>{if(e.target.closest('button'))return;e.preventDefault();jump()});\ndocument.getElementById('start').addEventListener('click',start);\nwindow.addEventListener('keydown',e=>{if(e.code==='Space'||e.code==='ArrowUp'){e.preventDefault();if(!e.repeat)jump()}});\ndocument.addEventListener('visibilitychange',()=>{last=0});\nfunction hit(o){const cx=Math.max(o.x,Math.min(playerX,o.x+o.w)),cy=Math.max(ground-o.h,Math.min(y,ground));return (playerX-cx)**2+(y-cy)**2<(radius-3)**2}\nfunction update(dt){distance+=speed*dt;speed=Math.min(450,290+distance/150);score=Math.floor(distance/35);scoreEl.textContent=score;vy+=1800*dt;y+=vy*dt;if(y>=ground-radius){if(vy>100)squash=.18;y=ground-radius;vy=0}squash*=Math.exp(-12*dt);spawnIn-=dt;if(spawnIn<=0){obstacles.push({x:W+30,w:26+Math.random()*14,h:34+Math.random()*22});spawnIn=1.3+Math.random()*.6}for(const o of obstacles){o.x-=speed*dt;if(hit(o)){end();break}}obstacles=obstacles.filter(o=>o.x+o.w>-30);trail.push({x:playerX,y,life:.22});for(const t of trail){t.x-=speed*dt;t.life-=dt}trail=trail.filter(t=>t.life>0)}\nfunction roundRect(x,y,w,h,r,color){ctx.fillStyle=color;ctx.beginPath();ctx.roundRect(x,y,w,h,r);ctx.fill()}\nfunction draw(){ctx.setTransform(canvas.width/W,0,0,canvas.height/H,0,0);ctx.fillStyle='#d9e7d5';ctx.fillRect(0,0,W,H);ctx.fillStyle='#e9efde';ctx.beginPath();ctx.arc(727,92,43,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#b7ccba';ctx.lineWidth=2;ctx.beginPath();for(let x=0;x<=W;x+=10){const yy=272+Math.sin((x+distance*.12)/125)*19; if(x===0)ctx.moveTo(x,yy);else ctx.lineTo(x,yy)}ctx.stroke();ctx.fillStyle='#c3d5bb';ctx.fillRect(0,ground,W,H-ground);ctx.fillStyle='#7f9e80';ctx.fillRect(0,ground,W,2);ctx.fillStyle='#a0b89a';for(let x=-(distance%80);x<W;x+=80)ctx.fillRect(x,ground+29,22,2);for(const t of trail){ctx.globalAlpha=t.life*.55;ctx.fillStyle='#658774';ctx.beginPath();ctx.arc(t.x,t.y,radius*.65,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;for(const o of obstacles){roundRect(o.x,ground-o.h,o.w,o.h,5,'#315d50');roundRect(o.x+5,ground-o.h+5,4,o.h-10,2,'#628774')}ctx.globalAlpha=Math.max(.12,.24-(ground-radius-y)/650);ctx.fillStyle='#315d50';ctx.beginPath();ctx.ellipse(playerX,ground+5,24,5,0,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;ctx.save();ctx.translate(playerX,y);ctx.scale(1+squash,1-squash);ctx.fillStyle='#f5ad59';ctx.beginPath();ctx.arc(0,0,radius,0,Math.PI*2);ctx.fill();ctx.fillStyle='#ffe0a0';ctx.beginPath();ctx.arc(-5,-6,6,0,Math.PI*2);ctx.fill();ctx.restore()}\nfunction frame(now){const dt=last?Math.min((now-last)/1000,.04):0;last=now;if(state==='running'&&!document.hidden){let remaining=dt;while(remaining>0&&state==='running'){const step=Math.min(remaining,1/120);update(step);remaining-=step}}draw();requestAnimationFrame(frame)}\nrequestAnimationFrame(frame);\n</script>\n</body>\n</html>\n"
