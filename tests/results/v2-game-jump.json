      "html": "<!doctype html>\n<html lang=\"zh-CN\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1, viewport-fit=cover\">\n<meta name=\"theme-color\" content=\"#182d30\">\n<title>跃线 · 小球跳障碍</title>\n<style>\n*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden}body{background:#182d30;color:#edf4e8;font-family:system-ui,-apple-system,\"Segoe UI\",sans-serif;touch-action:none;user-select:none;-webkit-user-select:none}main{height:100%;height:100dvh;display:flex;flex-direction:column;max-width:1100px;margin:auto;padding: max(24px,env(safe-area-inset-top)) 28px max(20px,env(safe-area-inset-bottom))}header{display:flex;align-items:center;justify-content:space-between;gap:20px}h1{margin:0;font-size:24px;letter-spacing:3px;font-weight:650}.tag{font-size:11px;color:#9eb3ac;letter-spacing:3px;margin-top:6px}.stats{display:flex;gap:28px}.stat small{display:block;color:#9eb3ac;font-size:10px;letter-spacing:2px}.stat strong{font-size:27px;font-weight:500;font-variant-numeric:tabular-nums}.stage{position:relative;flex:1;min-height:0;margin:24px 0 18px;border:1px solid #3d5554;border-radius:24px;overflow:hidden;background:#dfe7d5}canvas{width:100%;height:100%;display:block}.overlay{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;background:linear-gradient(180deg,#dfe7d51a,#dfe7d5cc);color:#203c3b}.overlay[hidden]{display:none}.eyebrow{font-size:11px;letter-spacing:4px;color:#53726b;margin-bottom:18px}.overlay h2{font-size:clamp(32px,6vw,56px);letter-spacing:2px;margin:0 0 14px;font-weight:650}.overlay p{font-size:14px;line-height:1.9;color:#56716a;margin:0 0 28px}button{border:0;border-radius:50px;background:#244944;color:#f1f4df;padding:17px 32px;font:600 15px system-ui;cursor:pointer;box-shadow:0 5px 0 #15332f;touch-action:manipulation}button:active{transform:translateY(3px);box-shadow:0 2px 0 #15332f}button:focus-visible{outline:3px solid #d49356;outline-offset:5px}.key{margin-top:22px;font-size:11px;color:#647d74;letter-spacing:1px}footer{display:flex;justify-content:space-between;color:#a6bbb1;font-size:12px;gap:12px}.dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:#d6b17b;margin-right:7px}.badge{letter-spacing:2px;font-size:10px}@media(max-width:600px){main{padding-left:16px;padding-right:16px}h1{font-size:21px}.stats{gap:18px}.stat strong{font-size:24px}.stage{margin-top:22px;border-radius:20px}.badge{display:none}footer{font-size:11px}}\n</style>\n</head>\n<body>\n<main>\n<header><div><h1>跃线 <span style=\"color:#d6b17b\">/</span></h1><div class=\"tag\">LITTLE BALL, BIG LEAP</div></div><div class=\"stats\"><div class=\"stat\"><small>本次距离</small><strong id=\"score\">0</strong></div><div class=\"stat\"><small>最佳距离</small><strong id=\"best\">0</strong></div></div></header>\n<section class=\"stage\" aria-label=\"小球跳障碍游戏\"><canvas id=\"game\"></canvas><div class=\"overlay\" id=\"overlay\"><div class=\"eyebrow\" id=\"eyebrow\">准备好，轻轻一跃</div><h2 id=\"title\">把障碍留在身后。</h2><p id=\"description\">点一下屏幕，小球就会跳起。<br>找准节奏，看看你能跑多远。</p><button id=\"start\">开始奔跑 →</button><div class=\"key\">点击 / 轻触屏幕 · 空格键也可以</div></div></section>\n<footer><span><i class=\"dot\"></i><span id=\"hint\">轻触跳跃，落地后可再次起跳</span></span><span class=\"badge\">保持轻盈 · KEEP GOING</span></footer>\n</main>\n<script>\n(() => {\n const canvas=document.getElementById('game'),ctx=canvas.getContext('2d');\n const overlay=document.getElementById('overlay'),scoreEl=document.getElementById('score'),bestEl=document.getElementById('best');\n let best=0;try{best=Number(localStorage.getItem('leap-best'))||0}catch{}bestEl.textContent=best;\n let w=0,h=0,ground=0,state='ready',distance=0,speed=260,spawn=1.5,obstacles=[],particles=[],last=0,elapsed=0;\n const ball={x:0,y:0,r:15,vy:0,squash:0};\n function resize(){const rect=canvas.getBoundingClientRect();w=rect.width;h=rect.height;const dpr=Math.min(window.devicePixelRatio||1,2);canvas.width=Math.round(w*dpr);canvas.height=Math.round(h*dpr);ctx.setTransform(dpr,0,0,dpr,0,0);ground=h*.76;ball.x=Math.min(120,w*.23);if(state!=='playing')ball.y=ground-ball.r;else ball.y=Math.min(ball.y,ground-ball.r)}\n window.addEventListener('resize',resize);resize();\n function start(){state='playing';distance=0;elapsed=0;speed=260;spawn=1.25;obstacles=[];particles=[];ball.y=ground-ball.r;ball.vy=0;ball.squash=.12;scoreEl.textContent='0';overlay.hidden=true;document.getElementById('hint').textContent='轻触跳跃，落地后可再次起跳';last=performance.now()}\n function jump(){if(state!=='playing')return;if(ball.y>=ground-ball.r-.5){ball.vy=-Math.sqrt(2*1500*112);ball.squash=-.15}}\n document.getElementById('start').addEventListener('click',start);\n canvas.addEventListener('pointerdown',e=>{e.preventDefault();jump()});\n window.addEventListener('keydown',e=>{if(e.code==='Space'||e.code==='ArrowUp'){e.preventDefault();if(e.repeat)return;if(state==='playing')jump();else start()}});\n document.addEventListener('visibilitychange',()=>{if(document.hidden&&state==='playing'){state='paused';overlay.hidden=false;document.getElementById('eyebrow').textContent='稍作停留';document.getElementById('title').textContent='跑道在等你。';document.getElementById('description').textContent='游戏已暂停，点击继续奔跑。';document.getElementById('start').textContent='继续奔跑 →'}});\n document.getElementById('start').removeEventListener('click',start);\n document.getElementById('start').addEventListener('click',()=>{if(state==='paused'){state='playing';overlay.hidden=true;last=performance.now()}else start()});\n function end(){state='over';const score=Math.floor(distance);if(score>best){best=score;bestEl.textContent=best;try{localStorage.setItem('leap-best',best)}catch{}}overlay.hidden=false;document.getElementById('eyebrow').textContent='一次停顿，下一次更远';document.getElementById('title').textContent='再跳远一点。';document.getElementById('description').textContent=`本次跑了 ${score} 米 · 最佳 ${best} 米`;document.getElementById('start').textContent='马上重来 ↗';document.getElementById('hint').textContent='准备好就再来一次';}\n function rounded(x,y,ww,hh,r){ctx.beginPath();ctx.roundRect(x,y,ww,hh,r);ctx.fill()}\n function draw(){ctx.clearRect(0,0,w,h);ctx.fillStyle='#dfe7d5';ctx.fillRect(0,0,w,h);\n ctx.fillStyle='#d2ddc9';for(let i=0;i<5;i++){const x=((i*w/3-distance*1.3)%(w+w/3)+w+w/3)%(w+w/3)-w/6;ctx.beginPath();ctx.ellipse(x,ground,w*.25,h*.21,0,Math.PI,Math.PI*2);ctx.fill()}\n ctx.strokeStyle='#b9cbb6';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(0,ground);ctx.lineTo(w,ground);ctx.stroke();ctx.fillStyle='#d5dfca';ctx.fillRect(0,ground+1,w,h-ground);\n ctx.fillStyle='#9fb39f';for(let i=0;i<w/70+2;i++){const x=(i*70-distance*10%70);rounded(x,ground+28,18,2,1)}\n ctx.fillStyle='#abc0a7';ctx.font='10px system-ui';ctx.fillText('ONE TAP. ONE LEAP.',24,h-25);\n for(const o of obstacles){ctx.fillStyle='#355b52';rounded(o.x,ground-o.h,o.w,o.h,5);ctx.fillStyle='#58796a';rounded(o.x+5,ground-o.h+5,o.w-10,4,2)}\n ctx.fillStyle='#54745c22';ctx.beginPath();ctx.ellipse(ball.x,ground+4,Math.max(7,19-(ground-ball.y)/13),4,0,0,Math.PI*2);ctx.fill();\n ctx.save();ctx.translate(ball.x,ball.y);ctx.scale(1+ball.squash,1-ball.squash);ctx.fillStyle='#cf8652';ctx.beginPath();ctx.arc(0,0,ball.r,0,Math.PI*2);ctx.fill();ctx.fillStyle='#edb481';ctx.beginPath();ctx.arc(-4,-5,5,0,Math.PI*2);ctx.fill();ctx.restore();\n for(const p of particles){ctx.globalAlpha=p.life/.3;ctx.fillStyle='#a8b69b';ctx.beginPath();ctx.arc(p.x,p.y,2,0,Math.PI*2);ctx.fill()}ctx.globalAlpha=1;\n }\n function frame(now){const dt=Math.min((now-last)/1000||0,.033);last=now;if(state==='playing'){elapsed+=dt;distance+=speed*dt/10;scoreEl.textContent=Math.floor(distance);speed=Math.min(420,260+elapsed*3);ball.vy+=1500*dt;ball.y+=ball.vy*dt;if(ball.y>=ground-ball.r){if(ball.vy>100){ball.squash=.2;for(let i=0;i<5;i++)particles.push({x:ball.x,y:ground, vx:-40-Math.random()*70,vy:-Math.random()*55,life:.3})}ball.y=ground-ball.r;ball.vy=0}ball.squash*=Math.exp(-dt*16);spawn-=dt;if(spawn<=0){obstacles.push({x:w+30,w:24+Math.random()*12,h:30+Math.random()*23});spawn=1.2+Math.random()*.65}for(const o of obstacles){o.x-=speed*dt;const cx=Math.max(o.x,Math.min(ball.x,o.x+o.w)),cy=Math.max(ground-o.h,Math.min(ball.y,ground));if((ball.x-cx)**2+(ball.y-cy)**2<(ball.r-2)**2){end();break}}obstacles=obstacles.filter(o=>o.x+o.w> -10);for(const p of particles){p.x+=p.vx*dt;p.y+=p.vy*dt;p.life-=dt}particles=particles.filter(p=>p.life>0)}draw();requestAnimationFrame(frame)}requestAnimationFrame(frame);\n})();\n</script>\n</body>\n</html>\n"
